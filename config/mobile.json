{
  "id": "mobile",
  "version": "1.0.0",
  "aliases": ["phone"],
  "label": { "ar": "موبايل", "en": "Mobile phone" },
  "note": "Rules follow Technical Design v4. Every threshold, weight and score basis below is a starting assumption to review with a phone reviewer (BRD section 8).",
  "currency": "EGP",
  "maxMonths": 24,
  "tcoYears": 5,
  "freshness": { "priceStockHours": 24, "deliveryGiftsHours": 72, "plansDays": 35, "specsDays": 60 },
  "zones": {
    "ids": ["greater_cairo", "alexandria", "other"],
    "labels": {
      "greater_cairo": { "ar": "القاهرة الكبرى", "en": "Greater Cairo" },
      "alexandria": { "ar": "إسكندرية", "en": "Alexandria" },
      "other": { "ar": "باقي المحافظات", "en": "Other governorates" }
    },
    "cities": {
      "cairo": "greater_cairo",
      "giza": "greater_cairo",
      "qalyubia": "greater_cairo",
      "alexandria": "alexandria",
      "dakahlia": "other",
      "gharbia": "other",
      "sharqia": "other",
      "monufia": "other",
      "beheira": "other",
      "ismailia": "other",
      "port_said": "other",
      "suez": "other",
      "fayoum": "other",
      "minya": "other",
      "assiut": "other",
      "sohag": "other",
      "qena": "other",
      "luxor": "other",
      "aswan": "other",
      "red_sea": "other",
      "south_sinai": "other",
      "other": "other"
    }
  },

  "attributes": [
    { "id": "perf", "label": { "ar": "الأداء", "en": "Performance" }, "unit": "/10", "type": "number", "higherIsBetter": true, "basis": { "min": 1, "max": 10 },
      "explain": { "ar": "أداء {value} من 10", "en": "Performance {value}/10" } },
    { "id": "camera", "label": { "ar": "الكاميرا", "en": "Camera" }, "unit": "/10", "type": "number", "higherIsBetter": true, "basis": { "min": 1, "max": 10 },
      "explain": { "ar": "كاميرا {value} من 10", "en": "Camera {value}/10" } },
    { "id": "battery_mah", "label": { "ar": "البطارية", "en": "Battery" }, "unit": "mAh", "type": "number", "higherIsBetter": true, "basis": { "min": 3000, "max": 7000 },
      "explain": { "ar": "بطارية {value} مللي أمبير", "en": "{value} mAh battery" } },
    { "id": "screen", "label": { "ar": "الشاشة", "en": "Screen" }, "unit": "/10", "type": "number", "higherIsBetter": true, "basis": { "min": 1, "max": 10 },
      "explain": { "ar": "شاشة {value} من 10", "en": "Screen {value}/10" } },
    { "id": "storage_gb", "label": { "ar": "المساحة", "en": "Storage" }, "unit": "GB", "type": "number", "higherIsBetter": true, "basis": { "min": 64, "max": 512 },
      "explain": { "ar": "مساحة {value} جيجا", "en": "{value} GB storage" } },
    { "id": "ram_gb", "label": { "ar": "الرامات", "en": "RAM" }, "unit": "GB", "type": "number", "higherIsBetter": true, "basis": { "min": 3, "max": 16 },
      "explain": { "ar": "رامات {value} جيجا", "en": "{value} GB RAM" } },
    { "id": "updates_years", "label": { "ar": "سنين التحديثات", "en": "Software updates" }, "unit": "years", "type": "number", "higherIsBetter": true, "basis": { "min": 1, "max": 7 },
      "explain": { "ar": "تحديثات {value} سنين", "en": "{value} years of updates" } },
    { "id": "service", "label": { "ar": "الصيانة والضمان في مصر", "en": "Service network in Egypt" }, "unit": "/10", "type": "number", "higherIsBetter": true, "basis": { "min": 1, "max": 10 },
      "explain": { "ar": "صيانة في مصر {value} من 10", "en": "Service in Egypt {value}/10" } },
    { "id": "ease", "label": { "ar": "سهولة الاستخدام", "en": "Ease of use" }, "unit": "/10", "type": "number", "higherIsBetter": true, "basis": { "min": 1, "max": 10 },
      "explain": { "ar": "سهولة استخدام {value} من 10", "en": "Ease of use {value}/10" } },
    { "id": "warranty_months", "label": { "ar": "الضمان", "en": "Warranty" }, "unit": "months", "type": "number", "higherIsBetter": true, "basis": { "min": 12, "max": 24 },
      "explain": { "ar": "ضمان {value} شهر", "en": "{value}-month warranty" } },
    { "id": "weight_g", "label": { "ar": "الخفة", "en": "Lightness" }, "unit": "g", "type": "number", "higherIsBetter": false, "basis": { "min": 150, "max": 230 },
      "explain": { "ar": "وزنه {value} جرام", "en": "Weighs {value} g" } },
    { "id": "charging_w", "label": { "ar": "سرعة الشحن", "en": "Charging speed" }, "unit": "W", "type": "number", "higherIsBetter": true, "basis": { "min": 10, "max": 120 },
      "explain": { "ar": "شحن {value} وات", "en": "{value} W charging" } },
    { "id": "os", "label": { "ar": "نظام التشغيل", "en": "Operating system" }, "type": "category", "values": ["android", "ios"] },
    { "id": "has_5g", "label": { "ar": "5G", "en": "5G" }, "type": "boolean", "higherIsBetter": true, "basis": { "min": 0, "max": 1 },
      "explain": { "ar": "بيدعم 5G", "en": "Supports 5G" } },
    { "id": "series", "label": { "ar": "الفئة", "en": "Series" }, "type": "category", "values": ["entry", "mid", "flagship"] }
  ],

  "baseWeights": {
    "perf": 1, "camera": 1, "battery_mah": 1, "screen": 0.6, "storage_gb": 0.4, "ram_gb": 0.3,
    "updates_years": 0.5, "service": 0.6, "ease": 0, "warranty_months": 0.2, "weight_g": 0, "charging_w": 0.2, "has_5g": 0
  },

  "slots": [
    { "id": "who", "group": "who", "always": true, "default": "me", "factors": ["who_for"],
      "label": { "ar": "لمين", "en": "Who it is for" },
      "question": { "ar": "الموبايل ده ليك ولا لحد تاني؟", "en": "Is the phone for you or someone else?" },
      "options": [
        { "id": "me", "label": { "ar": "ليّا", "en": "For me" } },
        { "id": "parent", "label": { "ar": "لحد كبير في السن", "en": "For an older relative" },
          "effects": { "weights": { "service": 1.2, "ease": 1.5, "battery_mah": 0.8, "screen": 0.4, "perf": -0.6, "camera": -0.4 } } },
        { "id": "kid", "label": { "ar": "لابني أو بنتي", "en": "For my child" },
          "effects": { "weights": { "battery_mah": 0.6, "service": 0.5, "ease": 0.5 } } }
      ] },

    { "id": "use", "group": "core", "always": true, "multi": true, "dependsOn": { "who": ["me", "kid"] }, "factors": ["main_use_intensity"],
      "label": { "ar": "الاستخدام", "en": "Main use" },
      "question": { "ar": "هيتستخدم في إيه أكتر؟ اختار كل اللي ينطبق", "en": "What will it be used for most? Pick all that apply" },
      "options": [
        { "id": "social", "label": { "ar": "سوشيال وفيديوهات", "en": "Social media and videos" }, "effects": { "weights": { "battery_mah": 0.5, "screen": 0.4 } } },
        { "id": "photo", "label": { "ar": "تصوير", "en": "Photos" }, "effects": { "weights": { "camera": 1.5 } } },
        { "id": "gaming", "label": { "ar": "ألعاب", "en": "Gaming" }, "effects": { "weights": { "perf": 1, "screen": 0.3, "ram_gb": 0.3 } } },
        { "id": "work", "label": { "ar": "شغل ومكالمات كتير", "en": "Work and lots of calls" }, "effects": { "weights": { "battery_mah": 1, "updates_years": 0.4 } } },
        { "id": "basic", "label": { "ar": "مكالمات وواتساب بس", "en": "Calls and WhatsApp only" }, "effects": { "weights": { "ease": 0.5, "battery_mah": 0.5, "perf": -0.3 } } }
      ] },

    { "id": "intensity", "group": "core", "default": "normal", "askIf": { "slot": "use", "answered": true }, "factors": ["main_use_intensity"],
      "label": { "ar": "كثافة الاستخدام", "en": "How heavy the use is" },
      "question": { "ar": "بتستخدمه قد إيه في اليوم؟", "en": "How much do you use it each day?" },
      "options": [
        { "id": "light", "label": { "ar": "قليل", "en": "Lightly" }, "effects": { "weights": { "perf": -0.3 } } },
        { "id": "normal", "label": { "ar": "عادي", "en": "Normally" } },
        { "id": "heavy", "label": { "ar": "طول اليوم", "en": "All day" }, "effects": { "weights": { "battery_mah": 0.8, "perf": 0.4, "charging_w": 0.4 } } }
      ] },

    { "id": "gameLevel", "group": "followup", "always": true, "dependsOn": { "use": ["gaming"] }, "factors": ["main_use_intensity"],
      "label": { "ar": "نوع الألعاب", "en": "Game level" },
      "question": { "ar": "بتلعب ألعاب تقيلة؟", "en": "Do you play heavy games?" },
      "options": [
        { "id": "heavy", "label": { "ar": "أيوه، زي PUBG على جرافيك عالي", "en": "Yes, heavy games on high graphics" },
          "effects": { "weights": { "perf": 2, "battery_mah": 0.4 },
            "must": [ { "attr": "ram_gb", "op": ">=", "value": 8, "why": { "ar": "الألعاب التقيلة محتاجة 8 جيجا رامات على الأقل", "en": "Heavy games need at least 8 GB RAM" } } ] } },
        { "id": "light", "label": { "ar": "لأ، ألعاب خفيفة", "en": "No, light games" }, "effects": { "weights": { "perf": 0.3 } } }
      ] },

    { "id": "photoType", "group": "followup", "always": true, "multi": true, "dependsOn": { "use": ["photo"] }, "factors": ["main_use_intensity"],
      "label": { "ar": "نوع التصوير", "en": "Photo type" },
      "question": { "ar": "بتصوّر إيه أكتر؟", "en": "What do you shoot most?" },
      "options": [
        { "id": "people", "label": { "ar": "ناس وسيلفي", "en": "People and selfies" }, "effects": { "weights": { "camera": 0.5 } } },
        { "id": "night", "label": { "ar": "بالليل وفي الإضاءة الضعيفة", "en": "Night and low light" }, "effects": { "weights": { "camera": 1.2 } } },
        { "id": "video", "label": { "ar": "فيديوهات وريلز", "en": "Video and reels" }, "effects": { "weights": { "camera": 0.8, "storage_gb": 0.8, "perf": 0.4 } } }
      ] },

    { "id": "parentUse", "group": "followup", "always": true, "dependsOn": { "who": ["parent"] }, "factors": ["main_use_intensity"],
      "label": { "ar": "استخدام الشخص الكبير", "en": "What they will use it for" },
      "question": { "ar": "هيستخدمه في إيه غالباً؟", "en": "What will they mostly use it for?" },
      "options": [
        { "id": "basic", "label": { "ar": "واتساب ومكالمات بس", "en": "WhatsApp and calls only" }, "effects": { "weights": { "battery_mah": 0.5, "ease": 0.5 } } },
        { "id": "more", "label": { "ar": "فيسبوك ويوتيوب وصور العيلة", "en": "Facebook, YouTube and family photos" }, "effects": { "weights": { "screen": 0.8, "camera": 0.5 } } }
      ] },

    { "id": "pain", "group": "followup", "multi": true, "dependsOn": { "who": ["me", "kid"] }, "factors": ["current_device_problem"],
      "label": { "ar": "مشكلة الموبايل الحالي", "en": "Problem with the current phone" },
      "question": { "ar": "إيه أكتر حاجة بتضايقك في الموبايل الحالي؟", "en": "What bothers you most about your current phone?" },
      "options": [
        { "id": "battery", "label": { "ar": "البطارية بتخلص بسرعة", "en": "Battery runs out fast" }, "effects": { "weights": { "battery_mah": 1.2 } } },
        { "id": "slow", "label": { "ar": "بقى بطيء وبيهنّج", "en": "It is slow and hangs" }, "effects": { "weights": { "perf": 1, "ram_gb": 0.3, "updates_years": 0.4 } } },
        { "id": "storage", "label": { "ar": "المساحة بتتملي", "en": "Storage keeps filling up" },
          "effects": { "weights": { "storage_gb": 1.5 },
            "must": [ { "attr": "storage_gb", "op": ">=", "value": 128, "why": { "ar": "عايز مساحة أكبر من 64 جيجا", "en": "You need more than 64 GB" } } ] } },
        { "id": "camera", "label": { "ar": "الصور وحشة", "en": "Photos look bad" }, "effects": { "weights": { "camera": 1 } } },
        { "id": "broke", "label": { "ar": "بيعطل والصيانة وحشة", "en": "It breaks and service is bad" }, "effects": { "weights": { "service": 1.2, "warranty_months": 0.5 } } }
      ] },

    { "id": "storageNeed", "group": "core", "default": "any", "factors": ["main_use_intensity"],
      "label": { "ar": "المساحة المطلوبة", "en": "Storage needed" },
      "question": { "ar": "محتاج مساحة قد إيه؟", "en": "How much storage do you need?" },
      "options": [
        { "id": "any", "label": { "ar": "مش فارقة", "en": "Any" } },
        { "id": "s128", "label": { "ar": "128 جيجا أو أكتر", "en": "128 GB or more" },
          "effects": { "must": [ { "attr": "storage_gb", "op": ">=", "value": 128, "why": { "ar": "إنت عايز 128 جيجا أو أكتر", "en": "You asked for 128 GB or more" } } ] } },
        { "id": "s256", "label": { "ar": "256 جيجا أو أكتر", "en": "256 GB or more" },
          "effects": { "must": [ { "attr": "storage_gb", "op": ">=", "value": 256, "why": { "ar": "إنت عايز 256 جيجا أو أكتر", "en": "You asked for 256 GB or more" } } ] } },
        { "id": "s512", "label": { "ar": "512 جيجا", "en": "512 GB" },
          "effects": { "must": [ { "attr": "storage_gb", "op": ">=", "value": 512, "why": { "ar": "إنت عايز 512 جيجا", "en": "You asked for 512 GB" } } ] } }
      ] },

    { "id": "compat", "group": "who", "manual": true, "multi": true, "default": "none", "factors": ["compatibility"],
      "note": "Asked only when the text names a device (tech-spec 4.1). No full ecosystem model.",
      "label": { "ar": "أجهزة تانية عندك", "en": "Devices you already own" },
      "question": { "ar": "عندك أجهزة لازم الموبايل يشتغل معاها؟", "en": "Do you have devices the phone must work with?" },
      "options": [
        { "id": "none", "label": { "ar": "لأ", "en": "No" } },
        { "id": "mac", "label": { "ar": "ماك أو آيباد", "en": "A Mac or iPad" },
          "effects": { "prefer": [ { "attr": "os", "op": "in", "value": ["ios"], "why": { "ar": "عندك ماك أو آيباد", "en": "You use a Mac or iPad" } } ] } },
        { "id": "apple_watch", "label": { "ar": "ساعة أبل", "en": "An Apple Watch" },
          "effects": { "must": [ { "attr": "os", "op": "in", "value": ["ios"], "why": { "ar": "ساعة أبل بتشتغل مع آيفون بس", "en": "An Apple Watch works only with an iPhone" } } ] } },
        { "id": "galaxy_watch", "label": { "ar": "ساعة سامسونج", "en": "A Galaxy Watch" },
          "effects": { "prefer": [ { "attr": "brand", "op": "in", "value": ["Samsung"], "why": { "ar": "ساعة سامسونج بتشتغل أحسن مع سامسونج", "en": "A Galaxy Watch works best with a Samsung phone" } } ] } }
      ] },

    { "id": "keep", "group": "core", "factors": ["resale_value", "software_updates"],
      "label": { "ar": "هتقعد بيه قد إيه", "en": "How long you will keep it" },
      "question": { "ar": "ناوي تقعد بيه قد إيه؟", "en": "How long will you keep it?" },
      "options": [
        { "id": "short", "label": { "ar": "سنة أو اتنين", "en": "One or two years" }, "effects": { "set": { "derived.keepShort": true } } },
        { "id": "long", "label": { "ar": "3 سنين أو أكتر", "en": "Three years or more" }, "effects": { "weights": { "updates_years": 1.2, "perf": 0.4, "service": 0.4 } } }
      ] },

    { "id": "os", "group": "preferences", "default": "any", "dependsOn": { "who": ["me"] },
      "askIf": { "path": "derived.maxPrice", "gte": 30000 }, "factors": ["brand_status"],
      "label": { "ar": "آيفون ولا أندرويد", "en": "iPhone or Android" },
      "question": { "ar": "آيفون ولا أندرويد؟", "en": "iPhone or Android?" },
      "options": [
        { "id": "any", "label": { "ar": "مش فارقة", "en": "Either" } },
        { "id": "ios", "label": { "ar": "آيفون بس", "en": "iPhone only" },
          "effects": { "must": [ { "attr": "os", "op": "in", "value": ["ios"], "why": { "ar": "إنت عايز آيفون", "en": "You want an iPhone" } } ] } },
        { "id": "android", "label": { "ar": "أندرويد بس", "en": "Android only" },
          "effects": { "must": [ { "attr": "os", "op": "in", "value": ["android"], "why": { "ar": "إنت عايز أندرويد", "en": "You want Android" } } ] } }
      ] },

    { "id": "pay", "group": "money", "always": true, "factors": ["payment_way"],
      "label": { "ar": "طريقة الدفع", "en": "Payment way" },
      "question": { "ar": "هتدفع إزاي؟", "en": "How will you pay?" },
      "options": [
        { "id": "cash", "label": { "ar": "كاش", "en": "Cash" }, "effects": { "set": { "money.pay": "cash" } } },
        { "id": "card", "label": { "ar": "تقسيط بالكريديت كارد", "en": "Credit card installments" }, "effects": { "set": { "money.pay": "card" } } },
        { "id": "finance", "label": { "ar": "تقسيط من شركة تمويل", "en": "Consumer-finance company" }, "effects": { "set": { "money.pay": "finance" } } }
      ] },

    { "id": "provider", "group": "money", "dependsOn": { "pay": ["card", "finance"] }, "askIf": { "signal": "providerMatters" }, "factors": ["payment_way", "installment_cost"],
      "label": { "ar": "البنك أو شركة التقسيط", "en": "Your bank or finance company" },
      "question": { "ar": "كارتك من أنهي بنك، أو بتقسّط مع أنهي شركة؟", "en": "Which bank is your card from, or which finance company do you use?" },
      "optionsSource": "plans.provider",
      "options": [
        { "id": "nilebank", "kind": "card", "label": { "ar": "بنك النيل (عينة)", "en": "Nile Bank (sample)" }, "effects": { "set": { "money.provider": "nilebank" } } },
        { "id": "horusbank", "kind": "card", "label": { "ar": "بنك حورس (عينة)", "en": "Horus Bank (sample)" }, "effects": { "set": { "money.provider": "horusbank" } } },
        { "id": "sahla", "kind": "finance", "label": { "ar": "سهلة للتمويل (عينة)", "en": "Sahla Finance (sample)" }, "effects": { "set": { "money.provider": "sahla" } } },
        { "id": "qest", "kind": "finance", "label": { "ar": "قسط باي (عينة)", "en": "Qest Pay (sample)" }, "effects": { "set": { "money.provider": "qest" } } }
      ] },

    { "id": "budget", "group": "money", "always": true, "dependsOn": { "pay": ["cash"] }, "factors": ["budget_monthly_down", "cash_price"],
      "numeric": { "path": "money.budget", "unit": "EGP", "min": 1000, "max": 300000 },
      "label": { "ar": "الميزانية", "en": "Budget" },
      "question": { "ar": "ميزانيتك في حدود كام؟", "en": "What is your budget?" },
      "options": [
        { "id": "b8000", "value": 8000, "label": { "ar": "لحد 8,000", "en": "Up to 8,000" } },
        { "id": "b12000", "value": 12000, "label": { "ar": "لحد 12,000", "en": "Up to 12,000" } },
        { "id": "b18000", "value": 18000, "label": { "ar": "لحد 18,000", "en": "Up to 18,000" } },
        { "id": "b25000", "value": 25000, "label": { "ar": "لحد 25,000", "en": "Up to 25,000" } },
        { "id": "b40000", "value": 40000, "label": { "ar": "لحد 40,000", "en": "Up to 40,000" } },
        { "id": "b60000", "value": 60000, "label": { "ar": "لحد 60,000", "en": "Up to 60,000" } },
        { "id": "b90000", "value": 90000, "label": { "ar": "أكتر من 60,000", "en": "Over 60,000" } }
      ] },

    { "id": "monthlyCap", "group": "money", "always": true, "dependsOn": { "pay": ["card", "finance"] }, "factors": ["budget_monthly_down"],
      "numeric": { "path": "money.monthlyCap", "unit": "EGP/month", "min": 100, "max": 50000 },
      "label": { "ar": "القسط الشهري", "en": "Monthly cap" },
      "question": { "ar": "تقدر تدفع كام في الشهر؟", "en": "How much can you pay per month?" },
      "options": [
        { "id": "m500", "value": 500, "label": { "ar": "لحد 500 في الشهر", "en": "Up to 500 a month" } },
        { "id": "m1000", "value": 1000, "label": { "ar": "لحد 1,000 في الشهر", "en": "Up to 1,000 a month" } },
        { "id": "m1500", "value": 1500, "label": { "ar": "لحد 1,500 في الشهر", "en": "Up to 1,500 a month" } },
        { "id": "m2500", "value": 2500, "label": { "ar": "لحد 2,500 في الشهر", "en": "Up to 2,500 a month" } },
        { "id": "m4000", "value": 4000, "label": { "ar": "لحد 4,000 في الشهر", "en": "Up to 4,000 a month" } }
      ] },

    { "id": "down", "group": "money", "default": "d0", "dependsOn": { "pay": ["card", "finance"] }, "askIf": { "signal": "downChangesPick" }, "factors": ["budget_monthly_down"],
