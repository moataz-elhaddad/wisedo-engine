  "derive": [
    { "id": "maxPrice", "type": "max_price", "target": "derived.maxPrice",
      "note": "Rough max price the buyer can reach: cash budget, or down + the most a monthly cap can finance under the reference plans. Used by checks and askIf only; ranking always quotes real plans. The required capacity (derived.requiredHp) is written by the room answer itself (see slots.room.note).",
      "refPlans": [
        { "kind": "card", "months": 12, "monthlyRate": 0, "adminShare": 0.05 },
        { "kind": "finance", "months": 18, "monthlyRate": 0.02, "adminShare": 0 },
        { "kind": "finance", "months": 24, "monthlyRate": 0.02, "adminShare": 0 }
      ] }
  ],

  "checks": [
    { "id": "big_room_low_budget",
      "when": { "all": [ { "path": "derived.requiredHp", "gte": 3 }, { "path": "derived.maxPrice", "lt": 28000 } ] },
      "message": { "ar": "الأوضة دي محتاجة 3 حصان أو أكتر، وده غالباً بيبدأ فوق الميزانية دي.", "en": "This room needs 3 hp or more, which usually starts above this budget." } },
    { "id": "very_big_room_two_units",
      "when": { "path": "derived.requiredHp", "gt": 5 },
      "message": { "ar": "المساحة دي كبيرة على تكييف واحد. فكّر في وحدتين أو تكييف مركزي؛ إحنا بنرشّح أكبر وحدة 5 حصان.", "en": "This space is a lot for one unit. Consider two units or a central system; we show the largest 5 hp units." } },
    { "id": "kitchen_size_up",
      "when": { "all": [ { "path": "derived.kitchen", "eq": true }, { "not": { "path": "derived.hotRoom", "eq": true } } ] },
      "message": { "ar": "المطبخ أو الأوضة المفتوحة عليه بتحتاج تكييف أكبر درجة. اختار المساحة مع 'مطبخ' في سؤال المساحة.", "en": "A kitchen or a room open to it needs one size up. Choose the room size with 'kitchen' in the room question." } },
    { "id": "hot_city_t3",
      "when": { "slot": "city", "in": ["minya", "assiut", "sohag", "qena", "luxor", "aswan", "red_sea"] },
      "message": { "ar": "في الصعيد والبحر الأحمر الحر بيعدّي 45 درجة: الأحسن كمبروسر T3 بيبرّد في الحر الشديد.", "en": "In Upper Egypt and the Red Sea the heat passes 45°C: prefer a T3 compressor rated for extreme heat." } },
    { "id": "heat_low_budget",
      "when": { "all": [ { "slot": "heatNeed", "in": ["cool_heat"] }, { "path": "derived.maxPrice", "lt": 22000 } ] },
      "message": { "ar": "البارد ساخن في الكتالوج ده بيبدأ فوق الميزانية دي غالباً.", "en": "In this catalog cool-and-heat units mostly start above this budget." } },
    { "id": "inverter_low_budget",
      "when": { "all": [ { "slot": "inverterNeed", "in": ["inverter"] }, { "path": "derived.maxPrice", "lt": 22000 } ] },
      "message": { "ar": "الإنفرتر في الكتالوج ده بيبدأ فوق الميزانية دي، بس بيرجّع فرق السعر من الفاتورة في كام سنة.", "en": "In this catalog inverters start above this budget, but they repay the difference on the bill within a few years." } },
    { "id": "own_installer",
      "when": { "path": "derived.ownInstaller", "eq": true },
      "message": { "ar": "حسبنا تكلفة تركيب عادية (حوالي 700 جنيه) في كل الأسعار علشان المقارنة تبقى عادلة. التركيب برّه التوكيل ممكن يأثر على الضمان.", "en": "We still count a standard installation (about 700 EGP) in every price so shops compare evenly. Installation outside the agent may affect the warranty." } }
  ],

  "runningCost": { "type": "attr", "attr": "kwh_year", "factor": 2.1,
    "note": "Yearly electricity = kwh_year (a typical Egyptian summer: about 8 hours a day for 5 months) x 2.1 EGP per kWh x 1 unit. The rate is an assumption between the middle household tiers; review against the current tariff.",
    "reason": { "ar": "استهلاك الكهربا بيتحسب في التكلفة على 5 سنين", "en": "Electricity is counted in the 5-year cost" } },

  "resale": null,

  "installCost": 700,

  "season": {
    "saleEvents": [
      { "id": "white_friday", "rule": "last_friday_of_november", "windowWeeks": [1, 10], "savingShare": [0.10, 0.20],
        "label": { "ar": "الوايت فرايداي", "en": "White Friday" },
        "note": "Expected 10-20% saving is an assumption from past seasons." }
    ],
    "monthAdvice": [],
    "note": "AC prices and install waits usually rise from May to August; month advice is not modelled yet (see docs/ac-NOTES.md)."
  },

  "factors": [
    { "id": "room_size", "group": "need", "name": "Room area", "status": "covered", "via": [ { "slot": "room" }, { "attribute": "cooling_hp" } ] },
    { "id": "heat_load", "group": "need", "name": "Heat load: sun, top floor, kitchen", "status": "covered", "via": [ { "slot": "room" }, { "slot": "roomType" } ] },
    { "id": "usage_hours", "group": "need", "name": "Hours of use per day", "status": "covered", "via": [ { "slot": "usage" } ] },
    { "id": "cooling_heating", "group": "need", "name": "Cool only or cool and heat", "status": "covered", "via": [ { "slot": "heatNeed" }, { "attribute": "heating" } ] },
    { "id": "noise", "group": "need", "name": "Noise (bedroom, night use)", "status": "covered", "via": [ { "slot": "roomType" }, { "attribute": "noise_db" } ] },
    { "id": "current_device_problem", "group": "need", "name": "Problem with the current AC", "status": "covered", "via": [ { "slot": "pain" } ] },
