{
  "id": "ac",
  "version": "1.0.0",
  "aliases": ["air_conditioner", "aircon"],
  "label": { "ar": "تكييف", "en": "Air conditioner" },
  "note": "Split air conditioners for the Egyptian market. Every threshold, weight, score basis, the sizing table (room area and heat -> horsepower), the EGP per kWh rate and the 700 EGP installation cost are starting assumptions to review with an AC reviewer (BRD section 8).",
  "currency": "EGP",
  "maxMonths": 24,
  "tcoYears": 5,
  "freshness": { "priceStockHours": 24, "deliveryGiftsHours": 72, "plansDays": 35, "specsDays": 60 },
  "zones": {
    "assumedZone": "greater_cairo",
    "ids": ["greater_cairo", "alexandria", "other"],
    "labels": {
      "greater_cairo": { "ar": "القاهرة الكبرى", "en": "Greater Cairo" },
      "alexandria": { "ar": "إسكندرية", "en": "Alexandria" },
      "other": { "ar": "باقي المحافظات", "en": "Other governorates" }
    },
    "cities": {
      "cairo": "greater_cairo",
      "giza": "greater_cairo",
      "qalyubia": "greater_cairo",
      "alexandria": "alexandria",
      "dakahlia": "other",
      "gharbia": "other",
      "sharqia": "other",
      "monufia": "other",
      "beheira": "other",
      "ismailia": "other",
      "port_said": "other",
      "suez": "other",
      "fayoum": "other",
      "minya": "other",
      "assiut": "other",
      "sohag": "other",
      "qena": "other",
      "luxor": "other",
      "aswan": "other",
      "red_sea": "other",
      "south_sinai": "other",
      "other": "other"
    }
  },

  "attributes": [
    { "id": "cooling_hp", "label": { "ar": "القدرة (حصان)", "en": "Cooling capacity" }, "unit": "hp", "type": "number", "higherIsBetter": true, "basis": { "min": 1.5, "max": 5 },
      "explain": { "ar": "قدرة {value} حصان", "en": "{value} hp cooling capacity" } },
    { "id": "inverter", "label": { "ar": "إنفرتر", "en": "Inverter" }, "type": "boolean", "higherIsBetter": true, "basis": { "min": 0, "max": 1 },
      "explain": { "ar": "تكنولوجيا إنفرتر (بيوفر كهربا وصوته أهدى)", "en": "Inverter compressor (uses less power, runs quieter)" } },
    { "id": "kwh_year", "label": { "ar": "استهلاك الكهربا", "en": "Electricity use" }, "unit": "kWh/year", "type": "number", "higherIsBetter": false, "basis": { "min": 600, "max": 4500 },
      "explain": { "ar": "بيستهلك حوالي {value} كيلووات في السنة", "en": "About {value} kWh a year" } },
    { "id": "noise_db", "label": { "ar": "الهدوء", "en": "Quietness" }, "unit": "dB", "type": "number", "higherIsBetter": false, "basis": { "min": 18, "max": 52 },
      "explain": { "ar": "صوت الوحدة الداخلية {value} ديسيبل", "en": "Indoor unit {value} dB" } },
    { "id": "cooling_speed", "label": { "ar": "سرعة التبريد", "en": "Cooling speed" }, "unit": "/10", "type": "number", "higherIsBetter": true, "basis": { "min": 1, "max": 10 },
      "explain": { "ar": "سرعة تبريد {value} من 10", "en": "Cooling speed {value}/10" } },
    { "id": "service", "label": { "ar": "الصيانة والتوكيل في مصر", "en": "Service network in Egypt" }, "unit": "/10", "type": "number", "higherIsBetter": true, "basis": { "min": 1, "max": 10 },
      "explain": { "ar": "صيانة في مصر {value} من 10", "en": "Service in Egypt {value}/10" } },
    { "id": "warranty_months", "label": { "ar": "ضمان الكمبروسر", "en": "Compressor warranty" }, "unit": "months", "type": "number", "higherIsBetter": true, "basis": { "min": 12, "max": 120 },
      "explain": { "ar": "ضمان الكمبروسر {value} شهر", "en": "{value}-month compressor warranty" } },
    { "id": "wifi", "label": { "ar": "واي فاي وتحكم من الموبايل", "en": "Wi-Fi smart control" }, "type": "boolean", "higherIsBetter": true, "basis": { "min": 0, "max": 1 },
      "explain": { "ar": "بيتحكم فيه من الموبايل", "en": "Controlled from your phone" } },
    { "id": "heating", "label": { "ar": "تدفئة", "en": "Heating" }, "type": "boolean", "higherIsBetter": true, "basis": { "min": 0, "max": 1 },
      "explain": { "ar": "بارد ساخن", "en": "Cools and heats" } },
    { "id": "low_voltage", "label": { "ar": "بيستحمل الكهربا الضعيفة", "en": "Works on low voltage" }, "type": "boolean", "higherIsBetter": true, "basis": { "min": 0, "max": 1 },
      "explain": { "ar": "بيشتغل لو الكهربا ضعيفة أو بتهبط", "en": "Keeps running when the voltage drops" } },
    { "id": "t3_rated", "label": { "ar": "كمبروسر للحر الشديد", "en": "Rated for extreme heat" }, "type": "boolean", "higherIsBetter": true, "basis": { "min": 0, "max": 1 },
      "explain": { "ar": "كمبروسر T3 بيبرّد في حر فوق 50 درجة", "en": "T3 compressor that cools above 50°C outside" } },
    { "id": "type", "label": { "ar": "النوع", "en": "Type" }, "type": "category", "values": ["wall_split", "floor_standing"] },
    { "id": "series", "label": { "ar": "الفئة", "en": "Series" }, "type": "category", "values": ["entry", "mid", "premium"] }
  ],

  "baseWeights": {
    "cooling_hp": 0, "inverter": 0.8, "kwh_year": 1, "noise_db": 0.4, "cooling_speed": 0.8, "service": 0.9,
    "warranty_months": 0.6, "wifi": 0.1, "heating": 0, "low_voltage": 0.3, "t3_rated": 0.3
  },

  "slots": [
    { "id": "room", "group": "core", "always": true, "factors": ["room_size", "heat_load"],
      "note": "Sizing table (assumption): up to 16 m2 -> 1.5 hp, 17-24 -> 2.25, 25-32 -> 3, 33-42 -> 4, 43-55 -> 5; a hot room (direct sun, top floor or kitchen) needs one size up. Each answer writes derived.requiredHp and a must on cooling_hp; a prefer drops units more than one size above the need (oversized units waste power). Area and heat share one question because the engine cannot yet combine two answers into one filter (see docs/ac-NOTES.md).",
      "label": { "ar": "مساحة الأوضة وحرارتها", "en": "Room size and heat" },
      "question": { "ar": "مساحة الأوضة قد إيه، وهل عليها شمس جامدة أو دور أخير أو مطبخ؟", "en": "How big is the room, and does it get strong sun, sit on the top floor or include a kitchen?" },
      "options": [
        { "id": "r16", "label": { "ar": "لحد 16 متر", "en": "Up to 16 m²" },
          "effects": { "set": { "derived.requiredHp": 1.5 },
            "must": [ { "attr": "cooling_hp", "op": ">=", "value": 1.5, "why": { "ar": "أوضة لحد 16 متر محتاجة 1.5 حصان", "en": "A room up to 16 m² needs 1.5 hp" } } ],
            "prefer": [ { "attr": "cooling_hp", "op": "<=", "value": 2.25, "why": { "ar": "تكييف أكبر من اللازم بيصرف كهربا على الفاضي", "en": "A much bigger unit than needed wastes power" } } ] } },
        { "id": "r16_hot", "label": { "ar": "لحد 16 متر، وعليها شمس أو دور أخير أو مطبخ", "en": "Up to 16 m², sunny, top floor or kitchen" },
          "effects": { "set": { "derived.requiredHp": 2.25, "derived.hotRoom": true },
            "must": [ { "attr": "cooling_hp", "op": ">=", "value": 2.25, "why": { "ar": "أوضة لحد 16 متر وحرّانة محتاجة 2.25 حصان", "en": "A hot room up to 16 m² needs 2.25 hp" } } ],
            "prefer": [ { "attr": "cooling_hp", "op": "<=", "value": 3, "why": { "ar": "تكييف أكبر من اللازم بيصرف كهربا على الفاضي", "en": "A much bigger unit than needed wastes power" } } ] } },
        { "id": "r24", "label": { "ar": "من 17 لـ 24 متر", "en": "17 to 24 m²" },
          "effects": { "set": { "derived.requiredHp": 2.25 },
            "must": [ { "attr": "cooling_hp", "op": ">=", "value": 2.25, "why": { "ar": "أوضة لحد 24 متر محتاجة 2.25 حصان", "en": "A room up to 24 m² needs 2.25 hp" } } ],
            "prefer": [ { "attr": "cooling_hp", "op": "<=", "value": 3, "why": { "ar": "تكييف أكبر من اللازم بيصرف كهربا على الفاضي", "en": "A much bigger unit than needed wastes power" } } ] } },
        { "id": "r24_hot", "label": { "ar": "من 17 لـ 24 متر، وعليها شمس أو دور أخير أو مطبخ", "en": "17 to 24 m², sunny, top floor or kitchen" },
          "effects": { "set": { "derived.requiredHp": 3, "derived.hotRoom": true },
            "must": [ { "attr": "cooling_hp", "op": ">=", "value": 3, "why": { "ar": "أوضة لحد 24 متر وحرّانة محتاجة 3 حصان", "en": "A hot room up to 24 m² needs 3 hp" } } ],
            "prefer": [ { "attr": "cooling_hp", "op": "<=", "value": 4, "why": { "ar": "تكييف أكبر من اللازم بيصرف كهربا على الفاضي", "en": "A much bigger unit than needed wastes power" } } ] } },
        { "id": "r32", "label": { "ar": "من 25 لـ 32 متر", "en": "25 to 32 m²" },
          "effects": { "set": { "derived.requiredHp": 3 },
            "must": [ { "attr": "cooling_hp", "op": ">=", "value": 3, "why": { "ar": "أوضة لحد 32 متر محتاجة 3 حصان", "en": "A room up to 32 m² needs 3 hp" } } ],
            "prefer": [ { "attr": "cooling_hp", "op": "<=", "value": 4, "why": { "ar": "تكييف أكبر من اللازم بيصرف كهربا على الفاضي", "en": "A much bigger unit than needed wastes power" } } ] } },
        { "id": "r32_hot", "label": { "ar": "من 25 لـ 32 متر، وعليها شمس أو دور أخير أو مطبخ", "en": "25 to 32 m², sunny, top floor or kitchen" },
          "effects": { "set": { "derived.requiredHp": 4, "derived.hotRoom": true },
            "must": [ { "attr": "cooling_hp", "op": ">=", "value": 4, "why": { "ar": "أوضة لحد 32 متر وحرّانة محتاجة 4 حصان", "en": "A hot room up to 32 m² needs 4 hp" } } ],
            "prefer": [ { "attr": "cooling_hp", "op": "<=", "value": 5, "why": { "ar": "تكييف أكبر من اللازم بيصرف كهربا على الفاضي", "en": "A much bigger unit than needed wastes power" } } ] } },
        { "id": "r42", "label": { "ar": "من 33 لـ 42 متر", "en": "33 to 42 m²" },
          "effects": { "set": { "derived.requiredHp": 4 },
            "must": [ { "attr": "cooling_hp", "op": ">=", "value": 4, "why": { "ar": "صالة لحد 42 متر محتاجة 4 حصان", "en": "A room up to 42 m² needs 4 hp" } } ] } },
        { "id": "r42_hot", "label": { "ar": "من 33 لـ 42 متر، وعليها شمس أو دور أخير أو مطبخ", "en": "33 to 42 m², sunny, top floor or kitchen" },
          "effects": { "set": { "derived.requiredHp": 5, "derived.hotRoom": true },
            "must": [ { "attr": "cooling_hp", "op": ">=", "value": 5, "why": { "ar": "صالة لحد 42 متر وحرّانة محتاجة 5 حصان", "en": "A hot room up to 42 m² needs 5 hp" } } ] } },
        { "id": "r55", "label": { "ar": "من 43 لـ 55 متر", "en": "43 to 55 m²" },
          "effects": { "set": { "derived.requiredHp": 5 },
            "must": [ { "attr": "cooling_hp", "op": ">=", "value": 5, "why": { "ar": "صالة لحد 55 متر محتاجة 5 حصان", "en": "A room up to 55 m² needs 5 hp" } } ] } },
        { "id": "r55_hot", "label": { "ar": "أكبر من 43 متر وحرّانة", "en": "Over 43 m² and hot" },
          "effects": { "set": { "derived.requiredHp": 6, "derived.hotRoom": true },
            "weights": { "cooling_speed": 0.5 },
            "must": [ { "attr": "cooling_hp", "op": ">=", "value": 5, "why": { "ar": "المساحة دي محتاجة 5 حصان على الأقل", "en": "This space needs at least 5 hp" } } ] } }
      ] },

    { "id": "roomType", "group": "core", "factors": ["noise", "heat_load"],
      "label": { "ar": "نوع الأوضة", "en": "Which room" },
      "question": { "ar": "التكييف ده لأنهي أوضة؟", "en": "Which room is it for?" },
      "options": [
        { "id": "bedroom", "label": { "ar": "أوضة نوم", "en": "Bedroom" }, "effects": { "weights": { "noise_db": 1.5, "inverter": 0.3 } } },
        { "id": "living", "label": { "ar": "صالة أو ريسبشن", "en": "Living room" }, "effects": { "weights": { "cooling_speed": 0.6 } } },
        { "id": "office", "label": { "ar": "مكتب أو محل", "en": "Office or shop" }, "effects": { "weights": { "cooling_speed": 0.6, "service": 0.4, "warranty_months": 0.3 } } },
        { "id": "kitchen", "label": { "ar": "مطبخ أو مفتوحة على المطبخ", "en": "Kitchen or open to the kitchen" }, "effects": { "set": { "derived.kitchen": true }, "weights": { "cooling_speed": 0.8 } } }
      ] },

    { "id": "usage", "group": "core", "factors": ["usage_hours", "running_cost"],
      "label": { "ar": "ساعات التشغيل", "en": "Hours of use" },
      "question": { "ar": "هتشغله قد إيه في اليوم في الصيف؟", "en": "How long will it run per day in summer?" },
      "options": [
        { "id": "few", "label": { "ar": "كام ساعة بس", "en": "A few hours" }, "effects": { "weights": { "kwh_year": -0.4, "inverter": -0.3 } } },
        { "id": "night", "label": { "ar": "طول الليل", "en": "All night" }, "effects": { "weights": { "noise_db": 0.8, "kwh_year": 0.4 } } },
        { "id": "allday", "label": { "ar": "طول اليوم تقريباً", "en": "Most of the day" }, "effects": { "weights": { "kwh_year": 1, "inverter": 0.6, "warranty_months": 0.3 } } }
      ] },

    { "id": "bill", "group": "core", "factors": ["running_cost", "inverter_tech"],
      "label": { "ar": "فاتورة الكهربا", "en": "Electricity bill" },
      "question": { "ar": "فاتورة الكهربا فارقة معاك قد إيه؟", "en": "How much does the electricity bill matter to you?" },
      "options": [
        { "id": "big", "label": { "ar": "فارقة جداً، عايز أوفّر", "en": "A lot, I want to save" }, "effects": { "weights": { "kwh_year": 1.5, "inverter": 1 } } },
        { "id": "normal", "label": { "ar": "عادي", "en": "Not much" } }
      ] },

    { "id": "heatNeed", "group": "core", "default": "cool", "factors": ["cooling_heating"],
      "label": { "ar": "بارد بس ولا بارد ساخن", "en": "Cool only or cool and heat" },
      "question": { "ar": "عايزه بارد بس ولا بارد ساخن للشتا كمان؟", "en": "Cooling only, or heating for winter too?" },
      "options": [
        { "id": "cool", "label": { "ar": "بارد بس", "en": "Cooling only" } },
        { "id": "cool_heat", "label": { "ar": "بارد ساخن", "en": "Cooling and heating" },
          "effects": { "must": [ { "attr": "heating", "op": "==", "value": true, "why": { "ar": "إنت عايز بارد ساخن", "en": "You want heating too" } } ] } }
      ] },

    { "id": "inverterNeed", "group": "core", "manual": true, "default": "any", "factors": ["inverter_tech"],
      "note": "Never asked: the bill question carries the trade-off. Set from text ('عايز انفرتر') or 'Add a detail'.",
      "label": { "ar": "إنفرتر ولا عادي", "en": "Inverter or conventional" },
      "question": { "ar": "عايزه إنفرتر؟", "en": "Do you want an inverter?" },
      "options": [
        { "id": "any", "label": { "ar": "مش فارقة", "en": "Either" } },
        { "id": "inverter", "label": { "ar": "إنفرتر بس", "en": "Inverter only" },
          "effects": { "must": [ { "attr": "inverter", "op": "==", "value": true, "why": { "ar": "إنت عايز إنفرتر", "en": "You want an inverter" } } ] } },
        { "id": "conventional", "label": { "ar": "عادي (مش إنفرتر)", "en": "Conventional (non-inverter)" },
          "effects": { "prefer": [ { "attr": "inverter", "op": "==", "value": false, "why": { "ar": "إنت مفضّل تكييف عادي", "en": "You prefer a conventional unit" } } ] } }
      ] },

    { "id": "pain", "group": "followup", "multi": true, "factors": ["current_device_problem", "power_quality"],
      "label": { "ar": "مشكلة التكييف الحالي", "en": "Problem with the current AC" },
      "question": { "ar": "إيه أكتر حاجة كانت بتضايقك في التكييف القديم؟", "en": "What bothered you most about your old AC?" },
      "options": [
        { "id": "noisy", "label": { "ar": "صوته عالي", "en": "It was noisy" }, "effects": { "weights": { "noise_db": 1.2 } } },
        { "id": "weak", "label": { "ar": "مش بيبرّد كويس", "en": "It did not cool well" }, "effects": { "weights": { "cooling_speed": 1.2 } } },
        { "id": "bill", "label": { "ar": "الفاتورة كانت عالية", "en": "The bill was high" }, "effects": { "weights": { "kwh_year": 1, "inverter": 0.6 } } },
        { "id": "broke", "label": { "ar": "بيعطل والصيانة وحشة", "en": "It broke and service was bad" }, "effects": { "weights": { "service": 1.2, "warranty_months": 0.8 } } },
        { "id": "power", "label": { "ar": "الكهربا عندنا ضعيفة وبتفصله", "en": "Our voltage is weak and trips it" },
          "effects": { "weights": { "low_voltage": 1.5 },
            "prefer": [ { "attr": "low_voltage", "op": "==", "value": true, "why": { "ar": "الكهربا عندك ضعيفة", "en": "Your voltage is weak" } } ] } }
      ] },

    { "id": "smart", "group": "preferences", "manual": true, "factors": ["smart_control"],
      "label": { "ar": "تحكم من الموبايل", "en": "Phone control" },
      "question": { "ar": "عايز تتحكم فيه من الموبايل؟", "en": "Do you want to control it from your phone?" },
      "options": [
        { "id": "yes", "label": { "ar": "أيوه", "en": "Yes" },
          "effects": { "weights": { "wifi": 1 }, "prefer": [ { "attr": "wifi", "op": "==", "value": true, "why": { "ar": "عايز واي فاي", "en": "You want Wi-Fi control" } } ] } },
        { "id": "no", "label": { "ar": "مش مهم", "en": "Not needed" } }
      ] },

    { "id": "install", "group": "logistics", "manual": true, "default": "shop", "factors": ["install_cost", "install_quality"],
      "note": "Who installs. Every quote counts the standard installation cost (installCost) unless the offer includes free installation, so shops compare evenly; 'own' only adds a check message (the engine has no per-buyer install cost yet).",
      "label": { "ar": "التركيب", "en": "Installation" },
      "question": { "ar": "مين هيركّب التكييف؟", "en": "Who will install it?" },
      "options": [
        { "id": "shop", "label": { "ar": "المحل أو التوكيل", "en": "The shop or the brand's installer" } },
        { "id": "own", "label": { "ar": "فني من عندي", "en": "My own technician" }, "effects": { "set": { "derived.ownInstaller": true } } }
      ] },

    { "id": "pay", "group": "money", "always": true, "factors": ["payment_way"],
      "label": { "ar": "طريقة الدفع", "en": "Payment way" },
      "question": { "ar": "هتدفع إزاي؟", "en": "How will you pay?" },
      "options": [
        { "id": "cash", "label": { "ar": "كاش", "en": "Cash" }, "effects": { "set": { "money.pay": "cash" } } },
        { "id": "card", "label": { "ar": "تقسيط بالكريديت كارد", "en": "Credit card installments" }, "effects": { "set": { "money.pay": "card" } } },
        { "id": "finance", "label": { "ar": "تقسيط من شركة تمويل", "en": "Consumer-finance company" }, "effects": { "set": { "money.pay": "finance" } } }
      ] },

    { "id": "provider", "group": "money", "dependsOn": { "pay": ["card", "finance"] }, "askIf": { "signal": "providerMatters" }, "factors": ["payment_way", "installment_cost"],
      "label": { "ar": "البنك أو شركة التقسيط", "en": "Your bank or finance company" },
      "question": { "ar": "كارتك من أنهي بنك، أو بتقسّط مع أنهي شركة؟", "en": "Which bank is your card from, or which finance company do you use?" },
      "optionsSource": "plans.provider",
      "options": [
        { "id": "nilebank", "kind": "card", "label": { "ar": "بنك النيل (عينة)", "en": "Nile Bank (sample)" }, "effects": { "set": { "money.provider": "nilebank" } } },
        { "id": "horusbank", "kind": "card", "label": { "ar": "بنك حورس (عينة)", "en": "Horus Bank (sample)" }, "effects": { "set": { "money.provider": "horusbank" } } },
        { "id": "sahla", "kind": "finance", "label": { "ar": "سهلة للتمويل (عينة)", "en": "Sahla Finance (sample)" }, "effects": { "set": { "money.provider": "sahla" } } },
        { "id": "qest", "kind": "finance", "label": { "ar": "قسط باي (عينة)", "en": "Qest Pay (sample)" }, "effects": { "set": { "money.provider": "qest" } } }
      ] },

    { "id": "budget", "group": "money", "always": true, "dependsOn": { "pay": ["cash"] }, "factors": ["budget_monthly_down", "cash_price"],
      "numeric": { "path": "money.budget", "unit": "EGP", "min": 5000, "max": 300000 },
