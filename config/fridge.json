{
  "id": "fridge",
  "version": "1.0.0",
  "aliases": ["refrigerator"],
  "label": { "ar": "تلاجة", "en": "Fridge" },
  "note": "Fridge category, built on the mobile template. Every threshold, weight, score basis, electricity price and capacity-by-household rule below is a starting assumption to review with an appliance reviewer (BRD section 8).",
  "currency": "EGP",
  "maxMonths": 36,
  "tcoYears": 5,
  "freshness": { "priceStockHours": 24, "deliveryGiftsHours": 72, "plansDays": 35, "specsDays": 60 },
  "zones": {
    "ids": ["greater_cairo", "alexandria", "other"],
    "labels": {
      "greater_cairo": { "ar": "القاهرة الكبرى", "en": "Greater Cairo" },
      "alexandria": { "ar": "إسكندرية", "en": "Alexandria" },
      "other": { "ar": "باقي المحافظات", "en": "Other governorates" }
    },
    "cities": {
      "cairo": "greater_cairo",
      "giza": "greater_cairo",
      "qalyubia": "greater_cairo",
      "alexandria": "alexandria",
      "dakahlia": "other",
      "gharbia": "other",
      "sharqia": "other",
      "monufia": "other",
      "beheira": "other",
      "ismailia": "other",
      "port_said": "other",
      "suez": "other",
      "fayoum": "other",
      "minya": "other",
      "assiut": "other",
      "sohag": "other",
      "qena": "other",
      "luxor": "other",
      "aswan": "other",
      "red_sea": "other",
      "south_sinai": "other",
      "other": "other"
    }
  },

  "attributes": [
    { "id": "capacity_l", "label": { "ar": "السعة", "en": "Capacity" }, "unit": "L", "type": "number", "higherIsBetter": true, "basis": { "min": 120, "max": 700 },
      "explain": { "ar": "سعة {value} لتر", "en": "{value} L capacity" } },
    { "id": "energy_kwh_year", "label": { "ar": "استهلاك الكهربا", "en": "Electricity use" }, "unit": "kWh/year", "type": "number", "higherIsBetter": false, "basis": { "min": 150, "max": 700 },
      "explain": { "ar": "بتصرف {value} كيلووات في السنة", "en": "Uses {value} kWh a year" } },
    { "id": "cooling", "label": { "ar": "قوة التبريد", "en": "Cooling performance" }, "unit": "/10", "type": "number", "higherIsBetter": true, "basis": { "min": 1, "max": 10 },
      "explain": { "ar": "تبريد {value} من 10", "en": "Cooling {value}/10" } },
    { "id": "noise_db", "label": { "ar": "الهدوء", "en": "Quietness" }, "unit": "dB", "type": "number", "higherIsBetter": false, "basis": { "min": 32, "max": 46 },
      "explain": { "ar": "صوتها {value} ديسيبل", "en": "{value} dB noise" } },
    { "id": "build", "label": { "ar": "الخامات والأرفف", "en": "Build and shelves" }, "unit": "/10", "type": "number", "higherIsBetter": true, "basis": { "min": 1, "max": 10 },
      "explain": { "ar": "خامات وأرفف {value} من 10", "en": "Build and shelves {value}/10" } },
    { "id": "service", "label": { "ar": "الصيانة والضمان في مصر", "en": "Service network in Egypt" }, "unit": "/10", "type": "number", "higherIsBetter": true, "basis": { "min": 1, "max": 10 },
      "explain": { "ar": "صيانة في مصر {value} من 10", "en": "Service in Egypt {value}/10" } },
    { "id": "warranty_months", "label": { "ar": "الضمان", "en": "Warranty" }, "unit": "months", "type": "number", "higherIsBetter": true, "basis": { "min": 12, "max": 120 },
      "explain": { "ar": "ضمان {value} شهر", "en": "{value}-month warranty" } },
    { "id": "inverter", "label": { "ar": "موتور إنفرتر", "en": "Inverter compressor" }, "type": "boolean", "higherIsBetter": true, "basis": { "min": 0, "max": 1 },
      "explain": { "ar": "موتور إنفرتر", "en": "Inverter compressor" } },
    { "id": "no_frost", "label": { "ar": "نوفروست", "en": "No frost" }, "type": "boolean", "higherIsBetter": true, "basis": { "min": 0, "max": 1 },
      "explain": { "ar": "نوفروست، مش محتاجة تسييح", "en": "No frost, never needs defrosting" } },
    { "id": "dispenser", "label": { "ar": "مبرد مياه", "en": "Water dispenser" }, "type": "boolean", "higherIsBetter": true, "basis": { "min": 0, "max": 1 },
      "explain": { "ar": "فيها مبرد مياه", "en": "Has a water dispenser" } },
    { "id": "width_cm", "label": { "ar": "العرض", "en": "Width" }, "unit": "cm", "type": "number", "higherIsBetter": false, "basis": { "min": 50, "max": 95 },
      "explain": { "ar": "عرضها {value} سم", "en": "{value} cm wide" } },
    { "id": "layout", "label": { "ar": "شكل الأبواب", "en": "Door layout" }, "type": "category", "values": ["single_door", "top_freezer", "bottom_freezer", "side_by_side", "french_door"] },
    { "id": "series", "label": { "ar": "الفئة", "en": "Series" }, "type": "category", "values": ["entry", "mid", "premium"] }
  ],

  "baseWeights": {
    "capacity_l": 0.8, "energy_kwh_year": 0.8, "cooling": 1, "noise_db": 0.3, "build": 0.6, "service": 0.8,
    "warranty_months": 0.4, "inverter": 0.4, "no_frost": 0.6, "dispenser": 0, "width_cm": 0
  },

  "slots": [
    { "id": "household", "group": "who", "always": true, "factors": ["household_size", "who_for"],
      "note": "No default: a default here would add a capacity must the buyer never stated. Capacity minimums are assumptions to review.",
      "label": { "ar": "عدد أفراد البيت", "en": "Household size" },
      "question": { "ar": "التلاجة لكام فرد في البيت؟", "en": "How many people will the fridge serve?" },
      "options": [
        { "id": "h2", "label": { "ar": "فرد أو اتنين", "en": "One or two" },
          "effects": { "weights": { "capacity_l": -0.5, "energy_kwh_year": 0.3 } } },
        { "id": "h4", "label": { "ar": "3 أو 4 أفراد", "en": "Three or four" },
          "effects": { "weights": { "capacity_l": 0.2 },
            "must": [ { "attr": "capacity_l", "op": ">=", "value": 330, "why": { "ar": "أسرة من 3-4 أفراد محتاجة 330 لتر على الأقل", "en": "A family of 3-4 needs at least 330 L" } } ] } },
        { "id": "h6", "label": { "ar": "5 أو 6 أفراد", "en": "Five or six" },
          "effects": { "weights": { "capacity_l": 0.6 },
            "must": [ { "attr": "capacity_l", "op": ">=", "value": 430, "why": { "ar": "أسرة من 5-6 أفراد محتاجة 430 لتر على الأقل", "en": "A family of 5-6 needs at least 430 L" } } ] } },
        { "id": "h7", "label": { "ar": "7 أفراد أو أكتر", "en": "Seven or more" },
          "effects": { "weights": { "capacity_l": 1 },
            "must": [ { "attr": "capacity_l", "op": ">=", "value": 520, "why": { "ar": "أسرة كبيرة من 7 أفراد أو أكتر محتاجة 520 لتر على الأقل", "en": "A household of 7 or more needs at least 520 L" } } ] } }
      ] },

    { "id": "use", "group": "core", "multi": true, "factors": ["main_use", "cooling_performance"],
      "label": { "ar": "الاستخدام", "en": "How you use it" },
      "question": { "ar": "بتستخدم التلاجة في إيه أكتر؟ اختار كل اللي ينطبق", "en": "How do you mostly use the fridge? Pick all that apply" },
      "options": [
        { "id": "bulk", "label": { "ar": "بشتري طلبات الشهر وبفرّز لحمة كتير", "en": "Monthly shopping and lots of frozen meat" }, "effects": { "weights": { "capacity_l": 0.8, "cooling": 0.3 } } },
        { "id": "cooking", "label": { "ar": "طبيخ كتير في البيت", "en": "Lots of home cooking" }, "effects": { "weights": { "cooling": 0.6, "build": 0.3 } } },
        { "id": "cold_drinks", "label": { "ar": "مياه ساقعة وعصاير طول الوقت", "en": "Cold water and drinks all the time" }, "effects": { "weights": { "dispenser": 1.2, "cooling": 0.3 } } },
        { "id": "basic", "label": { "ar": "استخدام بسيط", "en": "Light, basic use" }, "effects": { "weights": { "energy_kwh_year": 0.4, "capacity_l": -0.3 } } }
      ] },

    { "id": "power", "group": "core", "default": "normal", "factors": ["running_cost", "environment", "compressor_tech"],
      "label": { "ar": "الكهربا عندك", "en": "Electricity at home" },
      "question": { "ar": "إيه أهم حاجة عندك في الكهربا؟", "en": "What matters most about electricity at home?" },
      "options": [
        { "id": "normal", "label": { "ar": "مفيش مشكلة", "en": "No issue" } },
        { "id": "bills", "label": { "ar": "عايز أوفّر في فاتورة الكهربا", "en": "I want lower electricity bills" }, "effects": { "weights": { "energy_kwh_year": 1.5, "inverter": 0.8 } } },
        { "id": "cuts", "label": { "ar": "الكهربا بتقطع أو الفولت بيتذبذب", "en": "Power cuts or unstable voltage" }, "effects": { "weights": { "inverter": 0.6, "cooling": 0.6, "service": 0.3 } } }
      ] },

    { "id": "frost", "group": "core", "default": "any", "factors": ["no_frost_pref"],
      "label": { "ar": "نوفروست ولا ديفروست", "en": "No frost or manual defrost" },
      "question": { "ar": "لازم تكون نوفروست، ولا ديفروست عادي؟", "en": "Must it be no-frost, or is manual defrost fine?" },
      "options": [
        { "id": "any", "label": { "ar": "مش فارقة", "en": "Either" } },
        { "id": "no_frost", "label": { "ar": "نوفروست بس", "en": "No frost only" },
          "effects": { "must": [ { "attr": "no_frost", "op": "==", "value": true, "why": { "ar": "إنت عايزها نوفروست", "en": "You want a no-frost fridge" } } ] } },
        { "id": "defrost_ok", "label": { "ar": "ديفروست عادي لو أرخص", "en": "Manual defrost is fine if cheaper" }, "effects": { "weights": { "no_frost": -0.6 } } }
      ] },

    { "id": "space", "group": "core", "default": "any", "factors": ["physical_fit"],
      "note": "Width only. Height and door swing are not modelled.",
      "label": { "ar": "المساحة في المطبخ", "en": "Space in the kitchen" },
      "question": { "ar": "المكان اللي هتتحط فيه عرضه قد إيه؟", "en": "How wide is the space for the fridge?" },
      "options": [
        { "id": "any", "label": { "ar": "المساحة مش مشكلة", "en": "Space is not a problem" } },
        { "id": "w60", "label": { "ar": "لحد 60 سم", "en": "Up to 60 cm" },
          "effects": { "must": [ { "attr": "width_cm", "op": "<=", "value": 60, "why": { "ar": "المكان عرضه 60 سم بس", "en": "Your space is only 60 cm wide" } } ] } },
        { "id": "w70", "label": { "ar": "لحد 70 سم", "en": "Up to 70 cm" },
          "effects": { "must": [ { "attr": "width_cm", "op": "<=", "value": 70, "why": { "ar": "المكان عرضه 70 سم", "en": "Your space is 70 cm wide" } } ] } },
        { "id": "w80", "label": { "ar": "لحد 80 سم", "en": "Up to 80 cm" },
          "effects": { "must": [ { "attr": "width_cm", "op": "<=", "value": 80, "why": { "ar": "المكان عرضه 80 سم", "en": "Your space is 80 cm wide" } } ] } },
        { "id": "w95", "label": { "ar": "لحد 95 سم (ينفع سايد باي سايد)", "en": "Up to 95 cm (fits side-by-side)" },
          "effects": { "must": [ { "attr": "width_cm", "op": "<=", "value": 95, "why": { "ar": "المكان عرضه 95 سم", "en": "Your space is 95 cm wide" } } ] } }
      ] },

    { "id": "layout", "group": "preferences", "default": "any", "factors": ["layout_pref"],
      "label": { "ar": "شكل الأبواب", "en": "Door layout" },
      "question": { "ar": "عايز الفريزر فين وشكل الأبواب إيه؟", "en": "Which door layout do you want?" },
      "options": [
        { "id": "any", "label": { "ar": "مش فارقة", "en": "Any" } },
        { "id": "top_freezer", "label": { "ar": "فريزر فوق (بابين)", "en": "Freezer on top (two doors)" },
          "effects": { "must": [ { "attr": "layout", "op": "in", "value": ["top_freezer"], "why": { "ar": "إنت عايز الفريزر فوق", "en": "You want the freezer on top" } } ] } },
        { "id": "bottom_freezer", "label": { "ar": "فريزر تحت (درج)", "en": "Freezer at the bottom (drawer)" },
          "effects": { "must": [ { "attr": "layout", "op": "in", "value": ["bottom_freezer"], "why": { "ar": "إنت عايز الفريزر تحت", "en": "You want a bottom freezer" } } ] } },
        { "id": "side_by_side", "label": { "ar": "سايد باي سايد (بابين جنب بعض)", "en": "Side-by-side" },
          "effects": { "must": [ { "attr": "layout", "op": "in", "value": ["side_by_side"], "why": { "ar": "إنت عايز سايد باي سايد", "en": "You want a side-by-side" } } ] } },
        { "id": "french_door", "label": { "ar": "فرنساوي (بابين فوق ودرج تحت)", "en": "French door" },
          "effects": { "must": [ { "attr": "layout", "op": "in", "value": ["french_door"], "why": { "ar": "إنت عايز تلاجة فرنساوي", "en": "You want a French-door fridge" } } ] } },
        { "id": "single_door", "label": { "ar": "باب واحد", "en": "Single door" },
          "effects": { "must": [ { "attr": "layout", "op": "in", "value": ["single_door"], "why": { "ar": "إنت عايز تلاجة باب واحد", "en": "You want a single-door fridge" } } ] } }
      ] },

    { "id": "placement", "group": "core", "default": "kitchen", "factors": ["noise", "environment"],
      "label": { "ar": "مكان التلاجة", "en": "Where it will stand" },
      "question": { "ar": "التلاجة هتتحط فين؟", "en": "Where will the fridge stand?" },
      "options": [
        { "id": "kitchen", "label": { "ar": "في مطبخ مقفول", "en": "In a closed kitchen" } },
        { "id": "open", "label": { "ar": "في الصالة أو مطبخ مفتوح", "en": "In the living room or an open kitchen" }, "effects": { "weights": { "noise_db": 1.5 } } },
        { "id": "hot", "label": { "ar": "مطبخ حر أو دور أخير", "en": "A hot kitchen or top-floor flat" }, "effects": { "weights": { "cooling": 0.8, "inverter": 0.3 } } }
      ] },

    { "id": "dispenser", "group": "preferences", "default": "no", "factors": ["water_dispenser"],
      "label": { "ar": "مبرد مياه", "en": "Water dispenser" },
      "question": { "ar": "عايز مبرد مياه في الباب؟", "en": "Do you want a water dispenser in the door?" },
      "options": [
        { "id": "no", "label": { "ar": "مش محتاج", "en": "Not needed" } },
        { "id": "nice", "label": { "ar": "يبقى أحسن", "en": "Nice to have" }, "effects": { "weights": { "dispenser": 1.2 } } },
        { "id": "must", "label": { "ar": "لازم", "en": "Must have" },
          "effects": { "must": [ { "attr": "dispenser", "op": "==", "value": true, "why": { "ar": "إنت عايز مبرد مياه", "en": "You want a water dispenser" } } ] } }
      ] },

    { "id": "pain", "group": "followup", "multi": true, "factors": ["current_device_problem"],
      "label": { "ar": "مشكلة التلاجة الحالية", "en": "Problem with the current fridge" },
      "question": { "ar": "إيه أكتر حاجة بتضايقك في التلاجة الحالية؟", "en": "What bothers you most about your current fridge?" },
      "options": [
        { "id": "ice", "label": { "ar": "التلج بيتكوّم ولازم أسيّحها", "en": "Ice builds up and needs defrosting" },
          "effects": { "weights": { "no_frost": 1.5 },
            "prefer": [ { "attr": "no_frost", "op": "==", "value": true, "why": { "ar": "زهقت من التسييح", "en": "You are tired of defrosting" } } ] } },
        { "id": "bills", "label": { "ar": "بتسحب كهربا كتير", "en": "It uses too much electricity" }, "effects": { "weights": { "energy_kwh_year": 1, "inverter": 0.4 } } },
        { "id": "small", "label": { "ar": "صغيرة ومش مكفية", "en": "It is too small" }, "effects": { "weights": { "capacity_l": 1 } } },
        { "id": "noisy", "label": { "ar": "صوتها عالي", "en": "It is noisy" }, "effects": { "weights": { "noise_db": 1 } } },
        { "id": "weak", "label": { "ar": "التبريد ضعيف", "en": "Cooling is weak" }, "effects": { "weights": { "cooling": 1 } } },
        { "id": "broke", "label": { "ar": "بتعطل والصيانة وحشة", "en": "It breaks and service is bad" }, "effects": { "weights": { "service": 1.2, "warranty_months": 0.5 } } }
      ] },

    { "id": "pay", "group": "money", "always": true, "factors": ["payment_way"],
      "label": { "ar": "طريقة الدفع", "en": "Payment way" },
      "question": { "ar": "هتدفع إزاي؟", "en": "How will you pay?" },
      "options": [
        { "id": "cash", "label": { "ar": "كاش", "en": "Cash" }, "effects": { "set": { "money.pay": "cash" } } },
        { "id": "card", "label": { "ar": "تقسيط بالكريديت كارد", "en": "Credit card installments" }, "effects": { "set": { "money.pay": "card" } } },
        { "id": "finance", "label": { "ar": "تقسيط من شركة تمويل", "en": "Consumer-finance company" }, "effects": { "set": { "money.pay": "finance" } } }
      ] },

    { "id": "provider", "group": "money", "dependsOn": { "pay": ["card", "finance"] }, "askIf": { "signal": "providerMatters" }, "factors": ["payment_way", "installment_cost"],
      "label": { "ar": "البنك أو شركة التقسيط", "en": "Your bank or finance company" },
      "question": { "ar": "كارتك من أنهي بنك، أو بتقسّط مع أنهي شركة؟", "en": "Which bank is your card from, or which finance company do you use?" },
      "optionsSource": "plans.provider",
      "options": [
        { "id": "nilebank", "kind": "card", "label": { "ar": "بنك النيل (عينة)", "en": "Nile Bank (sample)" }, "effects": { "set": { "money.provider": "nilebank" } } },
        { "id": "horusbank", "kind": "card", "label": { "ar": "بنك حورس (عينة)", "en": "Horus Bank (sample)" }, "effects": { "set": { "money.provider": "horusbank" } } },
        { "id": "sahla", "kind": "finance", "label": { "ar": "سهلة للتمويل (عينة)", "en": "Sahla Finance (sample)" }, "effects": { "set": { "money.provider": "sahla" } } },
        { "id": "qest", "kind": "finance", "label": { "ar": "قسط باي (عينة)", "en": "Qest Pay (sample)" }, "effects": { "set": { "money.provider": "qest" } } }
      ] },

    { "id": "budget", "group": "money", "always": true, "dependsOn": { "pay": ["cash"] }, "factors": ["budget_monthly_down", "cash_price"],
      "numeric": { "path": "money.budget", "unit": "EGP", "min": 3000, "max": 400000 },
      "label": { "ar": "الميزانية", "en": "Budget" },
      "question": { "ar": "ميزانيتك للتلاجة في حدود كام؟", "en": "What is your budget for the fridge?" },
      "options": [
        { "id": "b15000", "value": 15000, "label": { "ar": "لحد 15,000", "en": "Up to 15,000" } },
        { "id": "b20000", "value": 20000, "label": { "ar": "لحد 20,000", "en": "Up to 20,000" } },
        { "id": "b30000", "value": 30000, "label": { "ar": "لحد 30,000", "en": "Up to 30,000" } },
        { "id": "b45000", "value": 45000, "label": { "ar": "لحد 45,000", "en": "Up to 45,000" } },
        { "id": "b60000", "value": 60000, "label": { "ar": "لحد 60,000", "en": "Up to 60,000" } },
        { "id": "b80000", "value": 80000, "label": { "ar": "لحد 80,000", "en": "Up to 80,000" } },
        { "id": "b120000", "value": 120000, "label": { "ar": "أكتر من 80,000", "en": "Over 80,000" } }
      ] },

    { "id": "monthlyCap", "group": "money", "always": true, "dependsOn": { "pay": ["card", "finance"] }, "factors": ["budget_monthly_down"],
      "numeric": { "path": "money.monthlyCap", "unit": "EGP/month", "min": 100, "max": 50000 },
      "label": { "ar": "القسط الشهري", "en": "Monthly cap" },
      "question": { "ar": "تقدر تدفع كام في الشهر؟", "en": "How much can you pay per month?" },
      "options": [
        { "id": "m750", "value": 750, "label": { "ar": "لحد 750 في الشهر", "en": "Up to 750 a month" } },
        { "id": "m1000", "value": 1000, "label": { "ar": "لحد 1,000 في الشهر", "en": "Up to 1,000 a month" } },
        { "id": "m1500", "value": 1500, "label": { "ar": "لحد 1,500 في الشهر", "en": "Up to 1,500 a month" } },
        { "id": "m2500", "value": 2500, "label": { "ar": "لحد 2,500 في الشهر", "en": "Up to 2,500 a month" } },
        { "id": "m4000", "value": 4000, "label": { "ar": "لحد 4,000 في الشهر", "en": "Up to 4,000 a month" } }
      ] },

    { "id": "down", "group": "money", "default": "d0", "dependsOn": { "pay": ["card", "finance"] }, "askIf": { "signal": "downChangesPick" }, "factors": ["budget_monthly_down"],
